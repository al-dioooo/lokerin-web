# Salin ke .env.local lalu isi. Jangan commit .env.local.

# Alamat lokerin-backend. Kosongkan untuk memakai data contoh tanpa server.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Client ID OAuth Google (tipe Web application) dari Google Auth Platform.
# Harus sama dengan salah satu GOOGLE_CLIENT_IDS di backend. Kosongkan untuk tombol Google versi demo.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
